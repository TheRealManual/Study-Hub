  "flashcards": [
    {
      "front": "Selective permeability?",
      "back": "Membrane allows some substances to cross more easily than others."
    },
    {
      "front": "Define osmosis.",
      "back": "Diffusion of water across a semipermeable membrane toward higher solute."
    },
    {
      "front": "Primary vs secondary active transport?",
      "back": "Direct ATP use vs use of stored ion gradient energy."
    },
    {
      "front": "Cholesterol’s role?",
      "back": "Stabilizes membrane fluidity and lowers permeability."
    },
    {
      "front": "Lysosome function?",
      "back": "Digest macromolecules and worn‑out organelles."
    },
    {
      "front": "Golgi apparatus role?",
      "back": "Modify, sort, and package proteins/lipids."
    },
    {
      "front": "Transcription vs translation location?",
      "back": "Nucleus vs ribosomes."
    },
    {
      "front": "What forms the mitotic spindle?",
      "back": "Microtubules."
    },
    {
      "front": "Semiconservative replication means?",
      "back": "Each daughter DNA has one original and one new strand."
    },
    {
      "front": "Apoptosis?",
      "back": "Programmed cell death."
    },
    {
      "front": "Receptor‑mediated endocytosis uses?",
      "back": "Clathrin‑coated pits."
    },
    {
      "front": "Why do carriers saturate?",
      "back": "Finite number limits maximal rate (Vmax)."
    }
